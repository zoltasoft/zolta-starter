# At least 32 characters. Use a distinct value for every deployed application.
NUXT_ZOLTA_IDENTITY_SESSION_SECRET=replace-with-a-long-random-secret
# Generate one with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=<secret>
ZOLTA_STARTER_SITE_URL=http://localhost:3000

# Create this confidential client in apps/identity-server, then copy its values here.
ZOLTA_STARTER_IDENTITY_API_URL=http://localhost:8100
ZOLTA_STARTER_IDENTITY_AUTH_URL=http://localhost:3100
ZOLTA_STARTER_IDENTITY_APPLICATION=zoltasoft-starter
ZOLTA_STARTER_IDENTITY_CLIENT_ID=
ZOLTA_STARTER_IDENTITY_CLIENT_SECRET=
ZOLTA_STARTER_IDENTITY_CALLBACK_URL=http://localhost:3000/api/identity/starter/auth/callback
