#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

node_run() {
  local command="$1"
  if [[ "${CI_RUNTIME:-docker}" == "host" ]]; then
    bash -lc "$command"
    return
  fi

  docker run --rm --user "$(id -u):$(id -g)" \
    -e CI=true \
    -e PNPM_CONFIG_STORE_DIR=/tmp/pnpm-store \
    -e COREPACK_HOME=/tmp/corepack \
    -e NUXT_SESSION_PASSWORD=ci-only-session-password-with-at-least-32-characters \
    -v "$root:/workspace" -w /workspace node:24.11-bookworm \
    bash -lc "mkdir -p /tmp/corepack-bin && corepack enable --install-directory /tmp/corepack-bin && export PATH=/tmp/corepack-bin:\$PATH && $command"
}

frontend() { node_run 'pnpm install --frozen-lockfile && pnpm lint'; }
build() { node_run 'pnpm install --frozen-lockfile && pnpm build'; }
security() {
  ./scripts/check-tracked-secrets.sh
  node_run 'pnpm install --frozen-lockfile && pnpm audit --prod'
}
image() { docker build --file docker/identity-console/Dockerfile --tag local/ci-identity-console .; }

case "${1:-fast}" in
  frontend) frontend ;;
  build) build ;;
  security) security ;;
  image) image ;;
  fast) frontend; security ;;
  full) frontend; security; build; image ;;
  *) echo "Usage: $0 {fast|full|frontend|build|security|image}" >&2; exit 64 ;;
esac
